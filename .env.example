# Copy this file to .env and fill it in. Get the Client ID from
# https://developer.spotify.com/dashboard → your app → Settings.
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Optional. Must match a Redirect URI registered in your Spotify app EXACTLY.
# If left out, the app uses the page it's served from:
#   local dev:     http://127.0.0.1:5173/
#   GitHub Pages:  https://<you>.github.io/<repo>/
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# Optional. URL of the deployed sync worker (see worker/ and the README).
# Leave unset to keep your shelves in this browser only.
# VITE_SYNC_URL=https://vinylpuffin-sync.<your-subdomain>.workers.dev
